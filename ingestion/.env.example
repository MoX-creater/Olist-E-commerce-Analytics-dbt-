PGHOST=localhost
PGPORT=5432
PGUSER=olist
PGPASSWORD=olist_pass
PGDATABASE=olist
PGSSLMODE=disable

# Data directory path (defaults to ../data relative to ingestion folder)
# DATA_DIR=../data

# For Neon or other cloud Postgres (requires SSL):
# PGHOST=your-neon-host.neon.tech
# PGPORT=5432
# PGUSER=your-user
# PGPASSWORD=your-password
# PGDATABASE=your-database
# PGSSLMODE=require
